# Copy this file to .env.local and fill in real values from your
# Supabase project (Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — never expose this to the browser. Used by
# app/api/appointments and app/api/enquiries to write bookings/enquiries
# from anonymous visitors (bypassing RLS safely, server-side only).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
